{
  "name": "outreachlead",
  "version": "2.0.0-beta.3",
  "private": true,
  "description": "Scheduled, personalised cold-outreach mail on Cloudflare Workers + D1 + Gmail API",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create dispatch",
    "db:init": "wrangler d1 execute outreachtool-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute outreachtool-db --local --file=./schema.sql",
    "tail": "wrangler tail",
    "test": "node --test tests/*.test.mjs",
    "build:embedded": "node scripts/package-worker.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  },
  "type": "module",
  "dependencies": {
    "postal-mime": "^4.1.4"
  }
}
